generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  price       Float
  createdAt   DateTime @default(now())
  category    String
  description String
  name        String
  rentPrice   Float
  id          String   @id @default(uuid())
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}
